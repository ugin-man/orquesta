{
  "$id": "organization-agent-placement-persistent-v1",
  "type": "object",
  "required": ["purpose", "capability_needs", "role_ref", "scope_ref", "requested_count", "coordination_hint"],
  "properties": {
    "purpose": { "type": "string", "maxLength": 8192, "pattern": "^.*\\S.*$" },
    "capability_needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9.-]*$" }
    },
    "role_ref": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "additionalProperties": false
    },
    "scope_ref": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["project", "line", "team"] },
        "id": { "type": "string", "maxLength": 256, "pattern": "^.*\\S.*$" }
      },
      "additionalProperties": false
    },
    "requested_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "coordination_hint": {
      "anyOf": [
        { "enum": ["peer", "supervised"] },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
