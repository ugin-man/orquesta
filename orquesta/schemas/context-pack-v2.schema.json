{
  "$id": "context-pack-v2",
  "type": "object",
  "required": [
    "version",
    "context_pack_id",
    "requirement_id",
    "task_intent_id",
    "task_envelope_id",
    "owner_agent_id",
    "status",
    "pack_layers",
    "selected_sources",
    "coverage_matrix",
    "budget_receipt",
    "retrieval_permissions",
    "staleness",
    "omitted_context",
    "fallback_reason",
    "provenance"
  ],
  "properties": {
    "version": { "const": 2 },
    "context_pack_id": { "type": "string", "pattern": "^CP2-[a-f0-9]{12}$" },
    "requirement_id": { "type": "string", "pattern": "^CR-[a-f0-9]{12}$" },
    "task_intent_id": { "type": "string", "pattern": ".+" },
    "task_envelope_id": { "type": "string", "pattern": "^TE-[a-f0-9]{12}$" },
    "owner_agent_id": { "type": "string", "pattern": ".+" },
    "status": {
      "enum": ["shadow", "draft", "ready", "needs_expansion", "needs_user", "stale"]
    },
    "pack_layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layer", "source_refs"],
        "properties": {
          "layer": {
            "enum": [
              "universal_contract",
              "task_envelope",
              "capability_slice",
              "project_sources"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": ".+" }
          }
        },
        "additionalProperties": false
      }
    },
    "selected_sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" }
    },
    "coverage_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "status", "source_refs"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": ".+" },
          "status": { "enum": ["covered", "partial", "uncovered"] },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "pattern": ".+" }
          }
        },
        "additionalProperties": false
      }
    },
    "budget_receipt": {
      "type": "object",
      "required": [
        "initial_budget",
        "selected_tokens",
        "omitted_tokens",
        "mandatory_overflow"
      ],
      "properties": {
        "initial_budget": { "type": "integer", "minimum": 0 },
        "selected_tokens": { "type": "integer", "minimum": 0 },
        "omitted_tokens": { "type": "integer", "minimum": 0 },
        "mandatory_overflow": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "retrieval_permissions": {
      "type": "object",
      "required": ["search", "open", "expand", "explain", "max_expansion_tokens"],
      "properties": {
        "search": { "type": "boolean" },
        "open": { "type": "boolean" },
        "expand": { "type": "boolean" },
        "explain": { "type": "boolean" },
        "max_expansion_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "staleness": {
      "type": "object",
      "required": ["state", "stale_source_ids"],
      "properties": {
        "state": { "enum": ["current", "contains_stale", "unknown"] },
        "stale_source_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" }
        }
      },
      "additionalProperties": false
    },
    "omitted_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "reason"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-[a-f0-9]{12}$" },
          "reason": {
            "enum": [
              "excluded",
              "superseded",
              "stale",
              "budget",
              "low_relevance",
              "duplicate"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "fallback_reason": {
      "anyOf": [
        { "type": "string", "pattern": ".+" },
        { "type": "null" }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_ref", "source_hash", "reason"],
        "properties": {
          "source_ref": { "type": "string", "pattern": ".+" },
          "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reason": { "type": "string", "pattern": ".+" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
