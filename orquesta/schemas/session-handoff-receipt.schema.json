{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orquesta.local/contracts/session-handoff-receipt.schema.json",
  "type": "object",
  "required": ["agent_id", "expected_generation", "observed_generation", "handoff_manifest_hash", "ready_to_assume_ownership", "evidence_checked", "next_action"],
  "properties": {
    "agent_id": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$" },
    "expected_generation": { "type": "integer", "minimum": 2 },
    "observed_generation": { "type": "integer", "minimum": 2 },
    "handoff_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ready_to_assume_ownership": { "const": true },
    "evidence_checked": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "next_action": { "type": "string", "pattern": ".+" }
  },
  "additionalProperties": false
}
